[
 {
  "t0": 0.8,
  "text": "侬站在人民广场，往四面看看：",
  "cue": "1-1",
  "t1": 4.24
 },
 {
  "t0": 4.29,
  "text": "市政府、博物馆、大剧院。",
  "cue": "1-2",
  "t1": 7.23
 },
 {
  "t0": 7.28,
  "text": "侬晓得伐，一百七十年前，",
  "cue": "1-3",
  "t1": 9.8
 },
 {
  "t0": 9.85,
  "text": "这块地是跑马场，还打过一仗。",
  "cue": "1-3",
  "t1": 13.5
 },
 {
  "t0": 13.55,
  "text": "一仗打下来，\n上海就变成了三个上海。",
  "cue": "1-4",
  "t1": 18.09
 },
 {
  "t0": 19.8,
  "text": "一八五三年，太平军打下南京，",
  "cue": "2-1",
  "t1": 22.73
 },
 {
  "t0": 22.78,
  "text": "租界里的外国人慌了，",
  "cue": "2-1",
  "t1": 24.86
 },
 {
  "t0": 24.91,
  "text": "开会组织起自己的武装——",
  "cue": "2-1",
  "t1": 27.96
 },
 {
  "t0": 28.01,
  "text": "万国商团，名义叫武装中立。",
  "cue": "2-2",
  "t1": 31.37
 },
 {
  "t0": 31.42,
  "text": "第二年四月，\n清兵要借道路过租界，",
  "cue": "2-3",
  "t1": 34.93
 },
 {
  "t0": 34.98,
  "text": "去打县城里的小刀会。",
  "cue": "2-3",
  "t1": 37.72
 },
 {
  "t0": 37.77,
  "text": "租界不借。",
  "cue": "2-4",
  "t1": 39.35
 },
 {
  "t0": 39.4,
  "text": "两边在泥城浜边上动了手，",
  "cue": "2-5",
  "t1": 41.96
 },
 {
  "t0": 42.01,
  "text": "就是今天人民广场、",
  "cue": "2-5",
  "t1": 43.91
 },
 {
  "t0": 43.96,
  "text": "西藏中路这一带。",
  "cue": "2-5",
  "t1": 46.34
 },
 {
  "t0": 46.39,
  "text": "不到两个钟头，清兵退了。",
  "cue": "2-6",
  "t1": 49.52
 },
 {
  "t0": 49.57,
  "text": "这一仗，史称泥城之战。",
  "cue": "2-7",
  "t1": 52.71
 },
 {
  "t0": 54.8,
  "text": "仗打完，外国人想明白一件事：",
  "cue": "3-1",
  "t1": 58.24
 },
 {
  "t0": 58.29,
  "text": "要管住这块地，",
  "cue": "3-2",
  "t1": 59.73
 },
 {
  "t0": 59.78,
  "text": "得有个自己的衙门。",
  "cue": "3-2",
  "t1": 62.35
 },
 {
  "t0": 62.4,
  "text": "一八五四年，工部局成立了：",
  "cue": "3-3",
  "t1": 65.6
 },
 {
  "t0": 65.65,
  "text": "修路、收税、派巡捕，样样它管。",
  "cue": "3-4",
  "t1": 69.21
 },
 {
  "t0": 69.26,
  "text": "可这个衙门，\n中国政府从来没有批准过——",
  "cue": "3-5",
  "t1": 73.63
 },
 {
  "t0": 73.68,
  "text": "它自己开会，自己选董事，",
  "cue": "3-6",
  "t1": 76.16
 },
 {
  "t0": 76.21,
  "text": "自己说了算。",
  "cue": "3-6",
  "t1": 78.37
 },
 {
  "t0": 80.8,
  "text": "一开始，工部局是英、美、",
  "cue": "4-1",
  "t1": 83.18
 },
 {
  "t0": 83.23,
  "text": "法三家合用的。",
  "cue": "4-1",
  "t1": 85.29
 },
 {
  "t0": 85.34,
  "text": "没过几年，法国人不干了：",
  "cue": "4-2",
  "t1": 88.31
 },
 {
  "t0": 88.36,
  "text": "一八六二年，法租界自立门户，",
  "cue": "4-3",
  "t1": 91.14
 },
 {
  "t0": 91.19,
  "text": "成立公董局——",
  "cue": "4-3",
  "t1": 93.12
 },
 {
  "t0": 93.17,
  "text": "自己的路自己修，",
  "cue": "4-4",
  "t1": 94.83
 },
 {
  "t0": 94.88,
  "text": "自己的税自己收。",
  "cue": "4-4",
  "t1": 97.48
 },
 {
  "t0": 99.8,
  "text": "第二年，\n英租界和美租界干脆合成一个，",
  "cue": "5-1",
  "t1": 103.75
 },
 {
  "t0": 103.8,
  "text": "就是后来的公共租界。",
  "cue": "5-1",
  "t1": 106.56
 },
 {
  "t0": 106.61,
  "text": "从此上海滩上，",
  "cue": "5-2",
  "t1": 108.06
 },
 {
  "t0": 108.11,
  "text": "两个外国衙门并排站着：",
  "cue": "5-2",
  "t1": 110.98
 },
 {
  "t0": 111.03,
  "text": "北面公共租界，归工部局；",
  "cue": "5-3",
  "t1": 114.01
 },
 {
  "t0": 114.06,
  "text": "南面法租界，归公董局。",
  "cue": "5-4",
  "t1": 117.2
 },
 {
  "t0": 121.8,
  "text": "衙门分了家，官司归谁管？",
  "cue": "6-1",
  "t1": 124.93
 },
 {
  "t0": 124.98,
  "text": "一八六四年，\n租界里设了会审公廨：",
  "cue": "6-2",
  "t1": 128.88
 },
 {
  "t0": 128.93,
  "text": "中国法官坐堂，",
  "cue": "6-3",
  "t1": 130.39
 },
 {
  "t0": 130.44,
  "text": "审租界里中国人的案子；",
  "cue": "6-3",
  "t1": 133.3
 },
 {
  "t0": 133.35,
  "text": "案子要是牵涉外国人，",
  "cue": "6-4",
  "t1": 135.47
 },
 {
  "t0": 135.52,
  "text": "还要有外国陪审坐在一边，",
  "cue": "6-4",
  "t1": 138.08
 },
 {
  "t0": 138.13,
  "text": "一起审。",
  "cue": "6-4",
  "t1": 139.65
 },
 {
  "t0": 139.7,
  "text": "租界里的中国人，",
  "cue": "6-5",
  "t1": 141.41
 },
 {
  "t0": 141.46,
  "text": "打官司进的是这么一个中西合办的衙门。",
  "cue": "6-5",
  "t1": 146.33
 },
 {
  "t0": 148.8,
  "text": "这还不算完。",
  "cue": "7-1",
  "t1": 150.61
 },
 {
  "t0": 150.66,
  "text": "租界嫌地盘小，",
  "cue": "7-2",
  "t1": 152.12
 },
 {
  "t0": 152.17,
  "text": "把路一条一条修到界外去：",
  "cue": "7-2",
  "t1": 155.27
 },
 {
  "t0": 155.32,
  "text": "路修到哪里，巡捕就管到哪里；",
  "cue": "7-3",
  "t1": 158.76
 },
 {
  "t0": 158.81,
  "text": "可路两边的地，",
  "cue": "7-4",
  "t1": 160.25
 },
 {
  "t0": 160.3,
  "text": "名义上还是中国的。",
  "cue": "7-4",
  "t1": 162.86
 },
 {
  "t0": 162.91,
  "text": "老上海把这个叫越界筑路——",
  "cue": "7-5",
  "t1": 165.97
 },
 {
  "t0": 166.02,
  "text": "一条马路，两种规矩。",
  "cue": "7-6",
  "t1": 168.93
 },
 {
  "t0": 171.8,
  "text": "县城那一边呢？",
  "cue": "8-1",
  "t1": 173.85
 },
 {
  "t0": 173.9,
  "text": "归道台，归县衙门，还是老规矩。",
  "cue": "8-2",
  "t1": 177.64
 },
 {
  "t0": 177.69,
  "text": "所以那辰光的上海人出趟门，",
  "cue": "8-3",
  "t1": 180.51
 },
 {
  "t0": 180.56,
  "text": "等于在三个城市之间穿来穿去：",
  "cue": "8-3",
  "t1": 184.15
 },
 {
  "t0": 184.2,
  "text": "过一条河，跨一条马路，",
  "cue": "8-4",
  "t1": 186.48
 },
 {
  "t0": 186.53,
  "text": "衙门就换了，规矩就变了。",
  "cue": "8-4",
  "t1": 189.72
 },
 {
  "t0": 189.77,
  "text": "这么着，过了近九十年。",
  "cue": "8-5",
  "t1": 192.66
 },
 {
  "t0": 192.71,
  "text": "下一集，讲讲马路的老名字——",
  "cue": "8-6",
  "t1": 195.92
 },
 {
  "t0": 195.97,
  "text": "侬从小走的威海路，",
  "cue": "8-7",
  "t1": 197.85
 },
 {
  "t0": 197.9,
  "text": "它原先叫啥名堂？",
  "cue": "8-7",
  "t1": 200.51
 }
]