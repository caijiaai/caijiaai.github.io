[
 {
  "id": "1-1",
  "para": 1,
  "shot": 1,
  "text": "侬站在人民广场，往四面看看：",
  "t": 0.8,
  "est": 2.94
 },
 {
  "id": "1-2",
  "para": 1,
  "shot": 1,
  "text": "市政府、博物馆、大剧院。",
  "t": 4.29,
  "est": 2.29
 },
 {
  "id": "1-3",
  "para": 1,
  "shot": 1,
  "text": "侬晓得伐，一百七十年前，这块地是跑马场，还打过一仗。",
  "t": 7.28,
  "est": 5.57
 },
 {
  "id": "1-4",
  "para": 1,
  "shot": 1,
  "text": "一仗打下来，上海就变成了三个上海。",
  "t": 13.55,
  "est": 3.64
 },
 {
  "id": "2-1",
  "para": 2,
  "shot": 2,
  "text": "一八五三年，太平军打下南京，租界里的外国人慌了，开会组织起自己的武装——",
  "t": 19.8,
  "est": 7.66
 },
 {
  "id": "2-2",
  "para": 2,
  "shot": 2,
  "text": "万国商团，名义叫武装中立。",
  "t": 28.01,
  "est": 2.71
 },
 {
  "id": "2-3",
  "para": 2,
  "shot": 2,
  "text": "第二年四月，清兵要借道路过租界，去打县城里的小刀会。",
  "t": 31.42,
  "est": 5.65
 },
 {
  "id": "2-4",
  "para": 2,
  "shot": 2,
  "text": "租界不借。",
  "t": 37.77,
  "est": 0.93
 },
 {
  "id": "2-5",
  "para": 2,
  "shot": 2,
  "text": "两边在泥城浜边上动了手，就是今天人民广场、西藏中路这一带。",
  "t": 39.4,
  "est": 6.3
 },
 {
  "id": "2-6",
  "para": 2,
  "shot": 2,
  "text": "不到两个钟头，清兵退了。",
  "t": 46.39,
  "est": 2.48
 },
 {
  "id": "2-7",
  "para": 2,
  "shot": 2,
  "text": "这一仗，史称泥城之战。",
  "t": 49.57,
  "est": 2.24
 },
 {
  "id": "3-1",
  "para": 3,
  "shot": 3,
  "text": "仗打完，外国人想明白一件事：",
  "t": 54.8,
  "est": 2.94
 },
 {
  "id": "3-2",
  "para": 3,
  "shot": 3,
  "text": "要管住这块地，得有个自己的衙门。",
  "t": 58.29,
  "est": 3.41
 },
 {
  "id": "3-3",
  "para": 3,
  "shot": 3,
  "text": "一八五四年，工部局成立了：",
  "t": 62.4,
  "est": 2.71
 },
 {
  "id": "3-4",
  "para": 3,
  "shot": 3,
  "text": "修路、收税、派巡捕，样样它管。",
  "t": 65.65,
  "est": 2.91
 },
 {
  "id": "3-5",
  "para": 3,
  "shot": 3,
  "text": "可这个衙门，中国政府从来没有批准过——",
  "t": 69.26,
  "est": 3.87
 },
 {
  "id": "3-6",
  "para": 3,
  "shot": 3,
  "text": "它自己开会，自己选董事，自己说了算。",
  "t": 73.68,
  "est": 3.79
 },
 {
  "id": "4-1",
  "para": 4,
  "shot": 4,
  "text": "一开始，工部局是英、美、法三家合用的。",
  "t": 80.8,
  "est": 3.84
 },
 {
  "id": "4-2",
  "para": 4,
  "shot": 4,
  "text": "没过几年，法国人不干了：",
  "t": 85.34,
  "est": 2.48
 },
 {
  "id": "4-3",
  "para": 4,
  "shot": 4,
  "text": "一八六二年，法租界自立门户，成立公董局——",
  "t": 88.36,
  "est": 4.25
 },
 {
  "id": "4-4",
  "para": 4,
  "shot": 4,
  "text": "自己的路自己修，自己的税自己收。",
  "t": 93.17,
  "est": 3.41
 },
 {
  "id": "5-1",
  "para": 5,
  "shot": 5,
  "text": "第二年，英租界和美租界干脆合成一个，就是后来的公共租界。",
  "t": 99.8,
  "est": 6.11
 },
 {
  "id": "5-2",
  "para": 5,
  "shot": 5,
  "text": "从此上海滩上，两个外国衙门并排站着：",
  "t": 106.61,
  "est": 3.87
 },
 {
  "id": "5-3",
  "para": 5,
  "shot": 5,
  "text": "北面公共租界，归工部局；",
  "t": 111.03,
  "est": 2.48
 },
 {
  "id": "5-4",
  "para": 5,
  "shot": 5,
  "text": "南面法租界，归公董局。",
  "t": 114.06,
  "est": 2.24
 },
 {
  "id": "6-1",
  "para": 6,
  "shot": 6,
  "text": "衙门分了家，官司归谁管？",
  "t": 121.8,
  "est": 2.48
 },
 {
  "id": "6-2",
  "para": 6,
  "shot": 6,
  "text": "一八六四年，租界里设了会审公廨：",
  "t": 124.98,
  "est": 3.41
 },
 {
  "id": "6-3",
  "para": 6,
  "shot": 6,
  "text": "中国法官坐堂，审租界里中国人的案子；",
  "t": 128.93,
  "est": 3.87
 },
 {
  "id": "6-4",
  "para": 6,
  "shot": 6,
  "text": "案子要是牵涉外国人，还要有外国陪审坐在一边，一起审。",
  "t": 133.35,
  "est": 5.65
 },
 {
  "id": "6-5",
  "para": 6,
  "shot": 6,
  "text": "租界里的中国人，打官司进的是这么一个中西合办的衙门。",
  "t": 139.7,
  "est": 5.73
 },
 {
  "id": "7-1",
  "para": 7,
  "shot": 7,
  "text": "这还不算完。",
  "t": 148.8,
  "est": 1.16
 },
 {
  "id": "7-2",
  "para": 7,
  "shot": 7,
  "text": "租界嫌地盘小，把路一条一条修到界外去：",
  "t": 150.66,
  "est": 4.1
 },
 {
  "id": "7-3",
  "para": 7,
  "shot": 7,
  "text": "路修到哪里，巡捕就管到哪里；",
  "t": 155.32,
  "est": 2.94
 },
 {
  "id": "7-4",
  "para": 7,
  "shot": 7,
  "text": "可路两边的地，名义上还是中国的。",
  "t": 158.81,
  "est": 3.41
 },
 {
  "id": "7-5",
  "para": 7,
  "shot": 7,
  "text": "老上海把这个叫越界筑路——",
  "t": 162.91,
  "est": 2.56
 },
 {
  "id": "7-6",
  "para": 7,
  "shot": 7,
  "text": "一条马路，两种规矩。",
  "t": 166.02,
  "est": 2.01
 },
 {
  "id": "8-1",
  "para": 8,
  "shot": 8,
  "text": "县城那一边呢？",
  "t": 171.8,
  "est": 1.4
 },
 {
  "id": "8-2",
  "para": 8,
  "shot": 8,
  "text": "归道台，归县衙门，还是老规矩。",
  "t": 173.9,
  "est": 3.09
 },
 {
  "id": "8-3",
  "para": 8,
  "shot": 8,
  "text": "所以那辰光的上海人出趟门，等于在三个城市之间穿来穿去：",
  "t": 177.69,
  "est": 5.96
 },
 {
  "id": "8-4",
  "para": 8,
  "shot": 8,
  "text": "过一条河，跨一条马路，衙门就换了，规矩就变了。",
  "t": 184.2,
  "est": 4.87
 },
 {
  "id": "8-5",
  "para": 8,
  "shot": 8,
  "text": "这么着，过了近九十年。",
  "t": 189.77,
  "est": 2.24
 },
 {
  "id": "8-6",
  "para": 8,
  "shot": 8,
  "text": "下一集，讲讲马路的老名字——",
  "t": 192.71,
  "est": 2.71
 },
 {
  "id": "8-7",
  "para": 8,
  "shot": 8,
  "text": "侬从小走的威海路，它原先叫啥名堂？",
  "t": 195.97,
  "est": 3.64
 }
]