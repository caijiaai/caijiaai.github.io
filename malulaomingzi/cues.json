[
 {
  "id": "1-1",
  "para": 1,
  "shot": 1,
  "text": "侬现在走在南京西路上，路牌写的是南京西路。",
  "t": 0.8,
  "est": 4.57
 },
 {
  "id": "1-2",
  "para": 1,
  "shot": 1,
  "text": "可老一辈嘴里，这条路叫静安寺路。",
  "t": 6.07,
  "est": 3.41
 },
 {
  "id": "1-3",
  "para": 1,
  "shot": 1,
  "text": "上海的马路，名字换过好几轮——",
  "t": 10.17,
  "est": 2.94
 },
 {
  "id": "1-4",
  "para": 1,
  "shot": 1,
  "text": "一个路名，就是一段历史。",
  "t": 13.67,
  "est": 2.48
 },
 {
  "id": "1-5",
  "para": 1,
  "shot": 1,
  "text": "这一集讲三条路：",
  "t": 16.84,
  "est": 1.63
 },
 {
  "id": "1-6",
  "para": 1,
  "shot": 1,
  "text": "一条大马路、一条法国路，还有一条我从小走的路。",
  "t": 19.02,
  "est": 4.9
 },
 {
  "id": "2-1",
  "para": 2,
  "shot": 2,
  "text": "先说静安寺路。",
  "t": 27.8,
  "est": 1.4
 },
 {
  "id": "2-2",
  "para": 2,
  "shot": 2,
  "text": "一八六二年，租界越界筑路，从跑马场往西，一路修到静安寺，英国人管它叫涌泉路。",
  "t": 29.9,
  "est": 8.27
 },
 {
  "id": "2-3",
  "para": 2,
  "shot": 2,
  "text": "这条路后来是上海顶繁华的一段：",
  "t": 38.87,
  "est": 3.26
 },
 {
  "id": "2-4",
  "para": 2,
  "shot": 2,
  "text": "大商场、电影院，全在路两边。",
  "t": 42.68,
  "est": 2.81
 },
 {
  "id": "2-5",
  "para": 2,
  "shot": 2,
  "text": "一九四五年，抗战胜利，静安寺路改名南京西路；",
  "t": 46.18,
  "est": 4.72
 },
 {
  "id": "2-6",
  "para": 2,
  "shot": 2,
  "text": "它东边的大马路，改名南京东路。",
  "t": 51.45,
  "est": 3.17
 },
 {
  "id": "2-7",
  "para": 2,
  "shot": 2,
  "text": "一条南京路，从此分了东西。",
  "t": 55.33,
  "est": 2.71
 },
 {
  "id": "3-1",
  "para": 3,
  "shot": 3,
  "text": "再说法国人的路。",
  "t": 62.3,
  "est": 1.63
 },
 {
  "id": "3-2",
  "para": 3,
  "shot": 3,
  "text": "法租界的大路，先叫西江路，再叫宝昌路，后来用了法国将军霞飞的名字，叫霞飞路。",
  "t": 64.63,
  "est": 8.27
 },
 {
  "id": "3-3",
  "para": 3,
  "shot": 3,
  "text": "霞飞路是老上海顶时髦的地方：",
  "t": 73.6,
  "est": 3.02
 },
 {
  "id": "3-4",
  "para": 3,
  "shot": 3,
  "text": "国泰大戏院、咖啡馆、绸缎庄，法国梧桐底下，夜夜笙歌。",
  "t": 77.18,
  "est": 5.38
 },
 {
  "id": "4-1",
  "para": 4,
  "shot": 4,
  "text": "租界一收回，路名先改。",
  "t": 86.8,
  "est": 2.24
 },
 {
  "id": "4-2",
  "para": 4,
  "shot": 4,
  "text": "一九四三年，爱多亚路改叫大上海路，霞飞路改叫泰山路；",
  "t": 89.74,
  "est": 5.65
 },
 {
  "id": "4-3",
  "para": 4,
  "shot": 4,
  "text": "一九四五年又改了一轮。",
  "t": 95.94,
  "est": 2.33
 },
 {
  "id": "4-4",
  "para": 4,
  "shot": 4,
  "text": "到一九五零年，名字定了型：",
  "t": 98.97,
  "est": 2.71
 },
 {
  "id": "4-5",
  "para": 4,
  "shot": 4,
  "text": "霞飞路成了淮海中路，纪念淮海战役。",
  "t": 102.23,
  "est": 3.64
 },
 {
  "id": "4-6",
  "para": 4,
  "shot": 4,
  "text": "路还是那条路，牌子换了主人。",
  "t": 106.56,
  "est": 2.94
 },
 {
  "id": "5-1",
  "para": 5,
  "shot": 5,
  "text": "第三条路，是我从小走的威海路。",
  "t": 113.8,
  "est": 3.17
 },
 {
  "id": "5-2",
  "para": 5,
  "shot": 5,
  "text": "它原名威海卫路，一九零一年筑路，名字是从山东的威海卫来的。",
  "t": 117.67,
  "est": 6.35
 },
 {
  "id": "5-3",
  "para": 5,
  "shot": 5,
  "text": "后来威海卫改叫威海，这条路也跟着去掉一个「卫」字，成了威海路。",
  "t": 124.72,
  "est": 6.35
 },
 {
  "id": "5-4",
  "para": 5,
  "shot": 5,
  "text": "名字短了一个字，路还是那么长。",
  "t": 131.77,
  "est": 3.17
 },
 {
  "id": "6-1",
  "para": 6,
  "shot": 6,
  "text": "威海路出名，不靠名字，靠行当。",
  "t": 139.3,
  "est": 3.09
 },
 {
  "id": "6-2",
  "para": 6,
  "shot": 6,
  "text": "一九二三年，头一家中国人的汽配店开在威海路上；",
  "t": 143.09,
  "est": 5.03
 },
 {
  "id": "6-3",
  "para": 6,
  "shot": 6,
  "text": "到一九四九年，整条街有两百三十家汽修汽配店，占了全上海的一半。",
  "t": 148.67,
  "est": 6.81
 },
 {
  "id": "6-4",
  "para": 6,
  "shot": 6,
  "text": "半个上海的汽车，都在这条路上修。",
  "t": 156.19,
  "est": 3.41
 },
 {
  "id": "7-1",
  "para": 7,
  "shot": 7,
  "text": "我小辰光，威海路已经是条汽配街了。",
  "t": 164.3,
  "est": 3.64
 },
 {
  "id": "7-2",
  "para": 7,
  "shot": 7,
  "text": "我姆妈在民立中学对面，开了一家化工贸汽配店；",
  "t": 168.64,
  "est": 4.8
 },
 {
  "id": "7-3",
  "para": 7,
  "shot": 7,
  "text": "我家就住在三六九号，斜对面就是上海电视台。",
  "t": 173.99,
  "est": 4.57
 },
 {
  "id": "7-4",
  "para": 7,
  "shot": 7,
  "text": "上海闲话里有句老话，叫「三六九，抓现钞」——",
  "t": 179.26,
  "est": 4.02
 },
 {
  "id": "7-5",
  "para": 7,
  "shot": 7,
  "text": "我家的门牌，正好是这三个数。",
  "t": 183.83,
  "est": 2.94
 },
 {
  "id": "8-1",
  "para": 8,
  "shot": 8,
  "text": "路名换了一茬又一茬，路两边的日子，一直往下过。",
  "t": 192.8,
  "est": 4.95
 },
 {
  "id": "8-2",
  "para": 8,
  "shot": 8,
  "text": "下一集，讲一块更有名的牌子：",
  "t": 198.45,
  "est": 2.94
 },
 {
  "id": "8-3",
  "para": 8,
  "shot": 8,
  "text": "外滩公园门口的「华人与狗不得入内」——",
  "t": 201.94,
  "est": 3.49
 },
 {
  "id": "8-4",
  "para": 8,
  "shot": 8,
  "text": "这块牌子，到底有没有过？",
  "t": 205.98,
  "est": 2.48
 }
]