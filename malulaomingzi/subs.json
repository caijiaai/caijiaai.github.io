[
 {
  "t0": 0.8,
  "text": "侬现在走在南京西路上，",
  "cue": "1-1",
  "t1": 3.14
 },
 {
  "t0": 3.19,
  "text": "路牌写的是南京西路。",
  "cue": "1-1",
  "t1": 6.02
 },
 {
  "t0": 6.07,
  "text": "可老一辈嘴里，这条路叫静安寺路。",
  "cue": "1-2",
  "t1": 10.12
 },
 {
  "t0": 10.17,
  "text": "上海的马路，名字换过好几轮——",
  "cue": "1-3",
  "t1": 13.62
 },
 {
  "t0": 13.67,
  "text": "一个路名，就是一段历史。",
  "cue": "1-4",
  "t1": 16.79
 },
 {
  "t0": 16.84,
  "text": "这一集讲三条路：",
  "cue": "1-5",
  "t1": 18.97
 },
 {
  "t0": 19.02,
  "text": "一条大马路、一条法国路，",
  "cue": "1-6",
  "t1": 21.53
 },
 {
  "t0": 21.58,
  "text": "还有一条我从小走的路。",
  "cue": "1-6",
  "t1": 24.82
 },
 {
  "t0": 27.8,
  "text": "先说静安寺路。",
  "cue": "2-1",
  "t1": 29.85
 },
 {
  "t0": 29.9,
  "text": "一八六二年，租界越界筑路，",
  "cue": "2-2",
  "t1": 32.68
 },
 {
  "t0": 32.73,
  "text": "从跑马场往西，一路修到静安寺，",
  "cue": "2-2",
  "t1": 35.94
 },
 {
  "t0": 35.99,
  "text": "英国人管它叫涌泉路。",
  "cue": "2-2",
  "t1": 38.82
 },
 {
  "t0": 38.87,
  "text": "这条路后来是上海顶繁华的一段：",
  "cue": "2-3",
  "t1": 42.63
 },
 {
  "t0": 42.68,
  "text": "大商场、电影院，全在路两边。",
  "cue": "2-4",
  "t1": 46.13
 },
 {
  "t0": 46.18,
  "text": "一九四五年，抗战胜利，",
  "cue": "2-5",
  "t1": 48.49
 },
 {
  "t0": 48.54,
  "text": "静安寺路改名南京西路；",
  "cue": "2-5",
  "t1": 51.4
 },
 {
  "t0": 51.45,
  "text": "它东边的大马路，改名南京东路。",
  "cue": "2-6",
  "t1": 55.28
 },
 {
  "t0": 55.33,
  "text": "一条南京路，从此分了东西。",
  "cue": "2-7",
  "t1": 58.94
 },
 {
  "t0": 62.3,
  "text": "再说法国人的路。",
  "cue": "3-1",
  "t1": 64.58
 },
 {
  "t0": 64.63,
  "text": "法租界的大路，先叫西江路，",
  "cue": "3-2",
  "t1": 67.34
 },
 {
  "t0": 67.39,
  "text": "再叫宝昌路，\n后来用了法国将军霞飞的名字，",
  "cue": "3-2",
  "t1": 71.79
 },
 {
  "t0": 71.84,
  "text": "叫霞飞路。",
  "cue": "3-2",
  "t1": 73.55
 },
 {
  "t0": 73.6,
  "text": "霞飞路是老上海顶时髦的地方：",
  "cue": "3-3",
  "t1": 77.13
 },
 {
  "t0": 77.18,
  "text": "国泰大戏院、咖啡馆、绸缎庄，",
  "cue": "3-4",
  "t1": 80.03
 },
 {
  "t0": 80.08,
  "text": "法国梧桐底下，夜夜笙歌。",
  "cue": "3-4",
  "t1": 83.46
 },
 {
  "t0": 86.8,
  "text": "租界一收回，路名先改。",
  "cue": "4-1",
  "t1": 89.69
 },
 {
  "t0": 89.74,
  "text": "一九四三年，\n爱多亚路改叫大上海路，",
  "cue": "4-2",
  "t1": 93.46
 },
 {
  "t0": 93.51,
  "text": "霞飞路改叫泰山路；",
  "cue": "4-2",
  "t1": 95.89
 },
 {
  "t0": 95.94,
  "text": "一九四五年又改了一轮。",
  "cue": "4-3",
  "t1": 98.92
 },
 {
  "t0": 98.97,
  "text": "到一九五零年，名字定了型：",
  "cue": "4-4",
  "t1": 102.18
 },
 {
  "t0": 102.23,
  "text": "霞飞路成了淮海中路，",
  "cue": "4-5",
  "t1": 104.32
 },
 {
  "t0": 104.37,
  "text": "纪念淮海战役。",
  "cue": "4-5",
  "t1": 106.51
 },
 {
  "t0": 106.56,
  "text": "路还是那条路，牌子换了主人。",
  "cue": "4-6",
  "t1": 110.4
 },
 {
  "t0": 113.8,
  "text": "第三条路，是我从小走的威海路。",
  "cue": "5-1",
  "t1": 117.62
 },
 {
  "t0": 117.67,
  "text": "它原名威海卫路，一九零一年筑路，",
  "cue": "5-2",
  "t1": 121.12
 },
 {
  "t0": 121.17,
  "text": "名字是从山东的威海卫来的。",
  "cue": "5-2",
  "t1": 124.67
 },
 {
  "t0": 124.72,
  "text": "后来威海卫改叫威海，",
  "cue": "5-3",
  "t1": 126.72
 },
 {
  "t0": 126.77,
  "text": "这条路也跟着去掉一个「卫」字，",
  "cue": "5-3",
  "t1": 129.79
 },
 {
  "t0": 129.84,
  "text": "成了威海路。",
  "cue": "5-3",
  "t1": 131.72
 },
 {
  "t0": 131.77,
  "text": "名字短了一个字，路还是那么长。",
  "cue": "5-4",
  "t1": 135.84
 },
 {
  "t0": 139.3,
  "text": "威海路出名，不靠名字，靠行当。",
  "cue": "6-1",
  "t1": 143.04
 },
 {
  "t0": 143.09,
  "text": "一九二三年，\n头一家中国人的汽配店开在威海路上；",
  "cue": "6-2",
  "t1": 148.62
 },
 {
  "t0": 148.67,
  "text": "到一九四九年，",
  "cue": "6-3",
  "t1": 150.16
 },
 {
  "t0": 150.21,
  "text": "整条街有两百三十家汽修汽配店，",
  "cue": "6-3",
  "t1": 153.45
 },
 {
  "t0": 153.5,
  "text": "占了全上海的一半。",
  "cue": "6-3",
  "t1": 156.14
 },
 {
  "t0": 156.19,
  "text": "半个上海的汽车，都在这条路上修。",
  "cue": "6-4",
  "t1": 160.5
 },
 {
  "t0": 164.3,
  "text": "我小辰光，\n威海路已经是条汽配街了。",
  "cue": "7-1",
  "t1": 168.59
 },
 {
  "t0": 168.64,
  "text": "我姆妈在民立中学对面，",
  "cue": "7-2",
  "t1": 170.99
 },
 {
  "t0": 171.04,
  "text": "开了一家化工贸汽配店；",
  "cue": "7-2",
  "t1": 173.94
 },
 {
  "t0": 173.99,
  "text": "我家就住在三六九号，",
  "cue": "7-3",
  "t1": 176.12
 },
 {
  "t0": 176.17,
  "text": "斜对面就是上海电视台。",
  "cue": "7-3",
  "t1": 179.21
 },
 {
  "t0": 179.26,
  "text": "上海闲话里有句老话，",
  "cue": "7-4",
  "t1": 181.04
 },
 {
  "t0": 181.09,
  "text": "叫「三六九，抓现钞」——",
  "cue": "7-4",
  "t1": 183.78
 },
 {
  "t0": 183.83,
  "text": "我家的门牌，正好是这三个数。",
  "cue": "7-5",
  "t1": 187.67
 },
 {
  "t0": 192.8,
  "text": "路名换了一茬又一茬，",
  "cue": "8-1",
  "t1": 194.9
 },
 {
  "t0": 194.95,
  "text": "路两边的日子，一直往下过。",
  "cue": "8-1",
  "t1": 198.4
 },
 {
  "t0": 198.45,
  "text": "下一集，讲一块更有名的牌子：",
  "cue": "8-2",
  "t1": 201.89
 },
 {
  "t0": 201.94,
  "text": "外滩公园门口的",
  "cue": "8-3",
  "t1": 203.18
 },
 {
  "t0": 203.23,
  "text": "「华人与狗不得入内」——",
  "cue": "8-3",
  "t1": 205.93
 },
 {
  "t0": 205.98,
  "text": "这块牌子，到底有没有过？",
  "cue": "8-4",
  "t1": 209.36
 }
]