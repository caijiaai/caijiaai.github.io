[
  { "t0": 2.8, "t1": 9.2, "text": "你每天走的这条路，绕一圈，又回到原来的地方。" },
  { "t0": 9.7, "t1": 13.3, "text": "它为啥是圆的？" },
  { "t0": 16.0, "t1": 20.4, "text": "四百多年前，这一圈是城墙。" },
  { "t0": 20.8, "t1": 25.6, "text": "嘉靖三十二年，倭寇一次次来犯，" },
  { "t0": 25.9, "t1": 30.3, "text": "上海人赶着把城墙筑了起来。" },
  { "t0": 30.7, "t1": 34.6, "text": "墙外，还挖了一圈濠沟。" },
  { "t0": 36.2, "t1": 39.8, "text": "1843年，上海开埠。" },
  { "t0": 40.2, "t1": 46.0, "text": "城墙北边、沿着黄浦江，慢慢长出另一座城。" },
  { "t0": 46.6, "t1": 51.2, "text": "外滩、马路、电车、玻璃橱窗。" },
  { "t0": 54.0, "t1": 58.2, "text": "墙里头，是城厢、窄弄堂。" },
  { "t0": 58.8, "t1": 63.4, "text": "墙外头，是马路、洋房、石库门。" },
  { "t0": 64.0, "t1": 68.4, "text": "两套日子，隔着一道墙过。" },
  { "t0": 72.5, "t1": 76.7, "text": "民国元年，城墙开始拆了。" },
  { "t0": 77.3, "t1": 81.5, "text": "城砖拆下来，填进了濠沟。" },
  { "t0": 82.0, "t1": 86.0, "text": "墙脚底下，铺出一条路。" },
  { "t0": 86.5, "t1": 91.6, "text": "北半圈叫民国路，南半圈叫中华路。" },
  { "t0": 94.0, "t1": 98.2, "text": "民国路，后来改叫人民路。" },
  { "t0": 98.8, "t1": 103.6, "text": "两条路接起来，现在还能走一圈。" },
  { "t0": 104.0, "t1": 108.6, "text": "大境阁旁边，还剩一小段老墙。" },
  { "t0": 109.0, "t1": 113.6, "text": "你天天走过的，就是从前的城墙。" }
]
