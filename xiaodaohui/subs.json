[
 {
  "t0": 0.8,
  "text": "侬走进石库门弄堂：",
  "cue": "1-1",
  "t1": 3.16
 },
 {
  "t0": 3.21,
  "text": "天井、老虎窗、晒台，热热闹闹。",
  "cue": "1-2",
  "t1": 6.77
 },
 {
  "t0": 6.82,
  "text": "侬晓得伐——",
  "cue": "1-3",
  "t1": 8.25
 },
 {
  "t0": 8.3,
  "text": "这房子最早，\n不是给上海本地人盖的，",
  "cue": "1-4",
  "t1": 12.02
 },
 {
  "t0": 12.07,
  "text": "是给逃难的人盖的。",
  "cue": "1-4",
  "t1": 14.85
 },
 {
  "t0": 16.8,
  "text": "一八四五年，租界刚划出来，",
  "cue": "2-1",
  "t1": 19.54
 },
 {
  "t0": 19.59,
  "text": "头一条死规矩，叫华洋分居。",
  "cue": "2-1",
  "t1": 23.02
 },
 {
  "t0": 23.07,
  "text": "洋人住租界，中国人住县城。",
  "cue": "2-2",
  "t1": 26.42
 },
 {
  "t0": 26.47,
  "text": "租界里头，华人不许租地，",
  "cue": "2-3",
  "t1": 28.99
 },
 {
  "t0": 29.04,
  "text": "不许造房子租给华人。",
  "cue": "2-3",
  "t1": 31.84
 },
 {
  "t0": 31.89,
  "text": "整个租界，\n拢总只有五百来个本地农民；",
  "cue": "2-4",
  "t1": 36.26
 },
 {
  "t0": 36.31,
  "text": "连给洋行做事的买办，",
  "cue": "2-5",
  "t1": 38.43
 },
 {
  "t0": 38.48,
  "text": "也只能住在租界外头。",
  "cue": "2-5",
  "t1": 41.55
 },
 {
  "t0": 44.8,
  "text": "一八五三年九月，县城出大事了。",
  "cue": "3-1",
  "t1": 48.62
 },
 {
  "t0": 48.67,
  "text": "刘丽川带着小刀会杀进上海县城，",
  "cue": "3-2",
  "t1": 51.81
 },
 {
  "t0": 51.86,
  "text": "占了县衙，\n总部设在豫园的点春堂。",
  "cue": "3-2",
  "t1": 56.13
 },
 {
  "t0": 56.18,
  "text": "一夜之间，县城换了主人。",
  "cue": "3-3",
  "t1": 59.56
 },
 {
  "t0": 62.8,
  "text": "这一占，就是十七个月。",
  "cue": "4-1",
  "t1": 65.69
 },
 {
  "t0": 65.74,
  "text": "城里是小刀会，城外是清兵围城。",
  "cue": "4-2",
  "t1": 69.57
 },
 {
  "t0": 69.62,
  "text": "老百姓夹在当中，房子烧了，",
  "cue": "4-3",
  "t1": 72.16
 },
 {
  "t0": 72.21,
  "text": "生意断了——",
  "cue": "4-3",
  "t1": 73.9
 },
 {
  "t0": 73.95,
  "text": "往哪里逃？",
  "cue": "4-4",
  "t1": 75.53
 },
 {
  "t0": 75.58,
  "text": "只剩城北面的租界。",
  "cue": "4-5",
  "t1": 78.1
 },
 {
  "t0": 78.15,
  "text": "规矩上不许住，可炮弹不认规矩。",
  "cue": "4-6",
  "t1": 82.22
 },
 {
  "t0": 84.8,
  "text": "人，就这么涌进去了。",
  "cue": "5-1",
  "t1": 87.46
 },
 {
  "t0": 87.51,
  "text": "租界里的中国人，从五百来人，",
  "cue": "5-2",
  "t1": 90.46
 },
 {
  "t0": 90.51,
  "text": "猛涨到两万多人。",
  "cue": "5-2",
  "t1": 92.88
 },
 {
  "t0": 92.93,
  "text": "十七个月后，小刀会撑不住，",
  "cue": "5-3",
  "t1": 95.65
 },
 {
  "t0": 95.7,
  "text": "突围了，刘丽川死在城外。",
  "cue": "5-3",
  "t1": 98.91
 },
 {
  "t0": 98.96,
  "text": "可是逃进租界的人，不走了。",
  "cue": "5-4",
  "t1": 102.57
 },
 {
  "t0": 104.8,
  "text": "领事急得跳脚：",
  "cue": "6-1",
  "t1": 106.7
 },
 {
  "t0": 106.75,
  "text": "章程写得清清楚楚，华人不许住！",
  "cue": "6-2",
  "t1": 110.57
 },
 {
  "t0": 110.62,
  "text": "洋行老板们不干：",
  "cue": "6-3",
  "t1": 112.75
 },
 {
  "t0": 112.8,
  "text": "有钱的带资金来，没钱的出力气，",
  "cue": "6-4",
  "t1": 115.86
 },
 {
  "t0": 115.91,
  "text": "房子还租得出价钱——",
  "cue": "6-4",
  "t1": 118.48
 },
 {
  "t0": 118.53,
  "text": "这种好事，哪里去找？",
  "cue": "6-5",
  "t1": 121.19
 },
 {
  "t0": 121.24,
  "text": "吵到最后，钱说了算。",
  "cue": "6-6",
  "t1": 123.9
 },
 {
  "t0": 123.95,
  "text": "一八五四年，\n三国领事把土地章程改了，",
  "cue": "6-7",
  "t1": 127.86
 },
 {
  "t0": 127.91,
  "text": "华洋分居那几条，划掉。",
  "cue": "6-7",
  "t1": 130.87
 },
 {
  "t0": 130.92,
  "text": "从这一年起，中国人住进租界，",
  "cue": "6-8",
  "t1": 133.82
 },
 {
  "t0": 133.87,
  "text": "合法了。",
  "cue": "6-8",
  "t1": 135.67
 },
 {
  "t0": 138.8,
  "text": "人来了，总要有地方住。",
  "cue": "7-1",
  "t1": 141.69
 },
 {
  "t0": 141.74,
  "text": "洋商大把大把盖房子：",
  "cue": "7-2",
  "t1": 144.34
 },
 {
  "t0": 144.39,
  "text": "先盖木板排屋，一排连一排，",
  "cue": "7-3",
  "t1": 146.94
 },
 {
  "t0": 146.99,
  "text": "十个月就盖了八百多幢，",
  "cue": "7-3",
  "t1": 149.13
 },
 {
  "t0": 149.18,
  "text": "名字都带一个「里」字——",
  "cue": "7-3",
  "t1": 152.08
 },
 {
  "t0": 152.13,
  "text": "这就是上海里弄的开头。",
  "cue": "7-4",
  "t1": 155.11
 },
 {
  "t0": 155.16,
  "text": "后来木板房怕火，",
  "cue": "7-5",
  "t1": 156.82
 },
 {
  "t0": 156.87,
  "text": "慢慢换成砖木结构：",
  "cue": "7-5",
  "t1": 159.29
 },
 {
  "t0": 159.34,
  "text": "石头门框，箍住一扇乌漆木门。",
  "cue": "7-6",
  "t1": 162.93
 },
 {
  "t0": 162.98,
  "text": "老上海叫它石箍门，叫顺了嘴，",
  "cue": "7-7",
  "t1": 165.92
 },
 {
  "t0": 165.97,
  "text": "就成了石库门。",
  "cue": "7-7",
  "t1": 168.12
 },
 {
  "t0": 168.17,
  "text": "一八七二年，\n宁波路旁边的兴仁里盖起来——",
  "cue": "7-8",
  "t1": 172.77
 },
 {
  "t0": 172.82,
  "text": "到今天都讲，它是最早的石库门。",
  "cue": "7-9",
  "t1": 176.89
 },
 {
  "t0": 181.8,
  "text": "所以侬记住：",
  "cue": "8-1",
  "t1": 183.46
 },
 {
  "t0": 183.51,
  "text": "石库门不是哪个设计师画出来的，",
  "cue": "8-2",
  "t1": 186.73
 },
 {
  "t0": 186.78,
  "text": "是人挤出来的。",
  "cue": "8-2",
  "t1": 188.96
 },
 {
  "t0": 189.01,
  "text": "五百人变两万人，一座城的住法，",
  "cue": "8-3",
  "t1": 192.17
 },
 {
  "t0": 192.22,
  "text": "就这么改了。",
  "cue": "8-3",
  "t1": 194.15
 },
 {
  "t0": 194.2,
  "text": "下趟走进弄堂，",
  "cue": "8-4",
  "t1": 195.57
 },
 {
  "t0": 195.62,
  "text": "摸一摸那扇石头门框——",
  "cue": "8-4",
  "t1": 198.34
 },
 {
  "t0": 198.39,
  "text": "门后头，\n是一百七十年前逃进租界的那些人。",
  "cue": "8-5",
  "t1": 203.37
 },
 {
  "t0": 203.42,
  "text": "下一集，讲一城三治：",
  "cue": "8-6",
  "t1": 205.93
 },
 {
  "t0": 205.98,
  "text": "一条马路，三个衙门。",
  "cue": "8-7",
  "t1": 208.89
 }
]