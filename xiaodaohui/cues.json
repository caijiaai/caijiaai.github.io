[
 {
  "id": "1-1",
  "para": 1,
  "shot": 1,
  "text": "侬走进石库门弄堂：",
  "t": 0.8,
  "est": 1.86
 },
 {
  "id": "1-2",
  "para": 1,
  "shot": 1,
  "text": "天井、老虎窗、晒台，热热闹闹。",
  "t": 3.21,
  "est": 2.91
 },
 {
  "id": "1-3",
  "para": 1,
  "shot": 1,
  "text": "侬晓得伐——",
  "t": 6.82,
  "est": 0.93
 },
 {
  "id": "1-4",
  "para": 1,
  "shot": 1,
  "text": "这房子最早，不是给上海本地人盖的，是给逃难的人盖的。",
  "t": 8.3,
  "est": 5.65
 },
 {
  "id": "2-1",
  "para": 2,
  "shot": 2,
  "text": "一八四五年，租界刚划出来，头一条死规矩，叫华洋分居。",
  "t": 16.8,
  "est": 5.57
 },
 {
  "id": "2-2",
  "para": 2,
  "shot": 2,
  "text": "洋人住租界，中国人住县城。",
  "t": 23.07,
  "est": 2.71
 },
 {
  "id": "2-3",
  "para": 2,
  "shot": 2,
  "text": "租界里头，华人不许租地，不许造房子租给华人。",
  "t": 26.47,
  "est": 4.72
 },
 {
  "id": "2-4",
  "para": 2,
  "shot": 2,
  "text": "整个租界，拢总只有五百来个本地农民；",
  "t": 31.89,
  "est": 3.87
 },
 {
  "id": "2-5",
  "para": 2,
  "shot": 2,
  "text": "连给洋行做事的买办，也只能住在租界外头。",
  "t": 36.31,
  "est": 4.34
 },
 {
  "id": "3-1",
  "para": 3,
  "shot": 3,
  "text": "一八五三年九月，县城出大事了。",
  "t": 44.8,
  "est": 3.17
 },
 {
  "id": "3-2",
  "para": 3,
  "shot": 3,
  "text": "刘丽川带着小刀会杀进上海县城，占了县衙，总部设在豫园的点春堂。",
  "t": 48.67,
  "est": 6.81
 },
 {
  "id": "3-3",
  "para": 3,
  "shot": 3,
  "text": "一夜之间，县城换了主人。",
  "t": 56.18,
  "est": 2.48
 },
 {
  "id": "4-1",
  "para": 4,
  "shot": 4,
  "text": "这一占，就是十七个月。",
  "t": 62.8,
  "est": 2.24
 },
 {
  "id": "4-2",
  "para": 4,
  "shot": 4,
  "text": "城里是小刀会，城外是清兵围城。",
  "t": 65.74,
  "est": 3.17
 },
 {
  "id": "4-3",
  "para": 4,
  "shot": 4,
  "text": "老百姓夹在当中，房子烧了，生意断了——",
  "t": 69.62,
  "est": 3.79
 },
 {
  "id": "4-4",
  "para": 4,
  "shot": 4,
  "text": "往哪里逃？",
  "t": 73.95,
  "est": 0.93
 },
 {
  "id": "4-5",
  "para": 4,
  "shot": 4,
  "text": "只剩城北面的租界。",
  "t": 75.58,
  "est": 1.86
 },
 {
  "id": "4-6",
  "para": 4,
  "shot": 4,
  "text": "规矩上不许住，可炮弹不认规矩。",
  "t": 78.15,
  "est": 3.17
 },
 {
  "id": "5-1",
  "para": 5,
  "shot": 5,
  "text": "人，就这么涌进去了。",
  "t": 84.8,
  "est": 2.01
 },
 {
  "id": "5-2",
  "para": 5,
  "shot": 5,
  "text": "租界里的中国人，从五百来人，猛涨到两万多人。",
  "t": 87.51,
  "est": 4.72
 },
 {
  "id": "5-3",
  "para": 5,
  "shot": 5,
  "text": "十七个月后，小刀会撑不住，突围了，刘丽川死在城外。",
  "t": 92.93,
  "est": 5.33
 },
 {
  "id": "5-4",
  "para": 5,
  "shot": 5,
  "text": "可是逃进租界的人，不走了。",
  "t": 98.96,
  "est": 2.71
 },
 {
  "id": "6-1",
  "para": 6,
  "shot": 6,
  "text": "领事急得跳脚：",
  "t": 104.8,
  "est": 1.4
 },
 {
  "id": "6-2",
  "para": 6,
  "shot": 6,
  "text": "章程写得清清楚楚，华人不许住！",
  "t": 106.75,
  "est": 3.17
 },
 {
  "id": "6-3",
  "para": 6,
  "shot": 6,
  "text": "洋行老板们不干：",
  "t": 110.62,
  "est": 1.63
 },
 {
  "id": "6-4",
  "para": 6,
  "shot": 6,
  "text": "有钱的带资金来，没钱的出力气，房子还租得出价钱——",
  "t": 112.8,
  "est": 5.18
 },
 {
  "id": "6-5",
  "para": 6,
  "shot": 6,
  "text": "这种好事，哪里去找？",
  "t": 118.53,
  "est": 2.01
 },
 {
  "id": "6-6",
  "para": 6,
  "shot": 6,
  "text": "吵到最后，钱说了算。",
  "t": 121.24,
  "est": 2.01
 },
 {
  "id": "6-7",
  "para": 6,
  "shot": 6,
  "text": "一八五四年，三国领事把土地章程改了，华洋分居那几条，划掉。",
  "t": 123.95,
  "est": 6.26
 },
 {
  "id": "6-8",
  "para": 6,
  "shot": 6,
  "text": "从这一年起，中国人住进租界，合法了。",
  "t": 130.92,
  "est": 3.79
 },
 {
  "id": "7-1",
  "para": 7,
  "shot": 7,
  "text": "人来了，总要有地方住。",
  "t": 138.8,
  "est": 2.24
 },
 {
  "id": "7-2",
  "para": 7,
  "shot": 7,
  "text": "洋商大把大把盖房子：",
  "t": 141.74,
  "est": 2.09
 },
 {
  "id": "7-3",
  "para": 7,
  "shot": 7,
  "text": "先盖木板排屋，一排连一排，十个月就盖了八百多幢，名字都带一个「里」字——",
  "t": 144.39,
  "est": 7.19
 },
 {
  "id": "7-4",
  "para": 7,
  "shot": 7,
  "text": "这就是上海里弄的开头。",
  "t": 152.13,
  "est": 2.33
 },
 {
  "id": "7-5",
  "para": 7,
  "shot": 7,
  "text": "后来木板房怕火，慢慢换成砖木结构：",
  "t": 155.16,
  "est": 3.64
 },
 {
  "id": "7-6",
  "para": 7,
  "shot": 7,
  "text": "石头门框，箍住一扇乌漆木门。",
  "t": 159.34,
  "est": 2.94
 },
 {
  "id": "7-7",
  "para": 7,
  "shot": 7,
  "text": "老上海叫它石箍门，叫顺了嘴，就成了石库门。",
  "t": 162.98,
  "est": 4.49
 },
 {
  "id": "7-8",
  "para": 7,
  "shot": 7,
  "text": "一八七二年，宁波路旁边的兴仁里盖起来——",
  "t": 168.17,
  "est": 4.1
 },
 {
  "id": "7-9",
  "para": 7,
  "shot": 7,
  "text": "到今天都讲，它是最早的石库门。",
  "t": 172.82,
  "est": 3.17
 },
 {
  "id": "8-1",
  "para": 8,
  "shot": 8,
  "text": "所以侬记住：",
  "t": 181.8,
  "est": 1.16
 },
 {
  "id": "8-2",
  "para": 8,
  "shot": 8,
  "text": "石库门不是哪个设计师画出来的，是人挤出来的。",
  "t": 183.51,
  "est": 4.8
 },
 {
  "id": "8-3",
  "para": 8,
  "shot": 8,
  "text": "五百人变两万人，一座城的住法，就这么改了。",
  "t": 189.01,
  "est": 4.49
 },
 {
  "id": "8-4",
  "para": 8,
  "shot": 8,
  "text": "下趟走进弄堂，摸一摸那扇石头门框——",
  "t": 194.2,
  "est": 3.64
 },
 {
  "id": "8-5",
  "para": 8,
  "shot": 8,
  "text": "门后头，是一百七十年前逃进租界的那些人。",
  "t": 198.39,
  "est": 4.34
 },
 {
  "id": "8-6",
  "para": 8,
  "shot": 8,
  "text": "下一集，讲一城三治：",
  "t": 203.42,
  "est": 2.01
 },
 {
  "id": "8-7",
  "para": 8,
  "shot": 8,
  "text": "一条马路，三个衙门。",
  "t": 205.98,
  "est": 2.01
 }
]