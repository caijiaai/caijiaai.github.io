[
 {
  "t0": 0.5,
  "t1": 2.86,
  "text": "侬每天开车走的延安东路，",
  "cue": "1-1"
 },
 {
  "t0": 2.91,
  "t1": 4.75,
  "text": "晓得伐——",
  "cue": "1-1"
 },
 {
  "t0": 4.8,
  "t1": 8.86,
  "text": "一百多年前，它不是路，是河。",
  "cue": "1-2"
 },
 {
  "t0": 9.0,
  "t1": 12.18,
  "text": "这条河叫洋泾浜，不到两公里长，",
  "cue": "2-1"
 },
 {
  "t0": 12.23,
  "t1": 15.15,
  "text": "二十米都不到宽。",
  "cue": "2-1"
 },
 {
  "t0": 15.3,
  "t1": 16.54,
  "text": "一八四五年，",
  "cue": "2-2"
 },
 {
  "t0": 16.59,
  "t1": 20.35,
  "text": "英国人在河的北边划了租界；",
  "cue": "2-2"
 },
 {
  "t0": 20.4,
  "t1": 21.64,
  "text": "一八四九年，",
  "cue": "2-3"
 },
 {
  "t0": 21.69,
  "t1": 25.15,
  "text": "法国人在南边也划了一块。",
  "cue": "2-3"
 },
 {
  "t0": 25.2,
  "t1": 26.45,
  "text": "一条小河浜，",
  "cue": "2-4"
 },
 {
  "t0": 26.5,
  "t1": 30.55,
  "text": "就这么成了两个租界的分界线。",
  "cue": "2-4"
 },
 {
  "t0": 30.6,
  "t1": 34.35,
  "text": "北岸归英租界管，路叫松江路；",
  "cue": "2-5"
 },
 {
  "t0": 34.4,
  "t1": 38.15,
  "text": "南岸归法租界，路叫孔子路。",
  "cue": "2-6"
 },
 {
  "t0": 38.2,
  "t1": 40.95,
  "text": "人要过河，就走桥——",
  "cue": "2-7"
 },
 {
  "t0": 41.0,
  "t1": 44.29,
  "text": "浜上前后架过九座桥。",
  "cue": "2-8"
 },
 {
  "t0": 46.0,
  "t1": 49.35,
  "text": "桥拆了，名字留下来了。",
  "cue": "3-1"
 },
 {
  "t0": 49.4,
  "t1": 52.32,
  "text": "侬现在路过的东新桥、八仙桥，",
  "cue": "3-2"
 },
 {
  "t0": 52.37,
  "t1": 55.27,
  "text": "找不到桥了对伐？",
  "cue": "3-2"
 },
 {
  "t0": 56.0,
  "t1": 58.6,
  "text": "桥就在地名里。",
  "cue": "3-3"
 },
 {
  "t0": 65.8,
  "t1": 67.92,
  "text": "河两边全是码头洋行，",
  "cue": "4-1"
 },
 {
  "t0": 67.97,
  "t1": 72.35,
  "text": "中国人外国人做生意，话讲不通。",
  "cue": "4-1"
 },
 {
  "t0": 72.4,
  "t1": 74.71,
  "text": "急中生智，上海话夹英语，",
  "cue": "4-2"
 },
 {
  "t0": 74.76,
  "t1": 78.32,
  "text": "凑出一套\"洋泾浜英语\"。",
  "cue": "4-2"
 },
 {
  "t0": 78.8,
  "t1": 81.25,
  "text": "老上海有句顺口溜：",
  "cue": "4-3"
 },
 {
  "t0": 81.3,
  "t1": 84.28,
  "text": "来是\"康姆\"，去是\"谷\"——",
  "cue": "4-4"
 },
 {
  "t0": 85.4,
  "t1": 87.27,
  "text": "康姆是来，谷是去，",
  "cue": "4-5"
 },
 {
  "t0": 87.32,
  "t1": 89.4,
  "text": "单词套上上海话的壳，",
  "cue": "4-5"
 },
 {
  "t0": 89.45,
  "t1": 91.93,
  "text": "能听懂就行。",
  "cue": "4-5"
 },
 {
  "t0": 92.0,
  "t1": 95.03,
  "text": "现在侬讲一个人英语讲得不地道，",
  "cue": "4-6"
 },
 {
  "t0": 95.08,
  "t1": 96.68,
  "text": "叫他\"洋泾浜\"，",
  "cue": "4-6"
 },
 {
  "t0": 96.73,
  "t1": 99.78,
  "text": "就是从这条河来的。",
  "cue": "4-6"
 },
 {
  "t0": 105.8,
  "t1": 108.76,
  "text": "到了一九一四年，河淤塞发臭，",
  "cue": "5-1"
 },
 {
  "t0": 108.81,
  "t1": 113.03,
  "text": "桥又堵路，英法两租界一商量：",
  "cue": "5-1"
 },
 {
  "t0": 113.4,
  "t1": 115.2,
  "text": "填了。",
  "cue": "5-2"
 },
 {
  "t0": 115.4,
  "t1": 117.53,
  "text": "两年工夫，河道填平，",
  "cue": "5-3"
 },
 {
  "t0": 117.58,
  "t1": 120.36,
  "text": "连两岸小路并成一条大马路，",
  "cue": "5-3"
 },
 {
  "t0": 120.41,
  "t1": 123.79,
  "text": "是当时上海最宽的路。",
  "cue": "5-3"
 },
 {
  "t0": 135.8,
  "t1": 138.95,
  "text": "路修好了，名字吵翻了。",
  "cue": "6-1"
 },
 {
  "t0": 139.0,
  "t1": 143.15,
  "text": "英国人要起英国名，法国人不干。",
  "cue": "6-2"
 },
 {
  "t0": 143.2,
  "t1": 144.85,
  "text": "最后妥协：",
  "cue": "6-3"
 },
 {
  "t0": 144.9,
  "t1": 147.54,
  "text": "用英国国王爱德华七世的名，",
  "cue": "6-4"
 },
 {
  "t0": 147.59,
  "t1": 150.35,
  "text": "按法文的读法——",
  "cue": "6-4"
 },
 {
  "t0": 150.4,
  "t1": 152.53,
  "text": "爱多亚路。",
  "cue": "6-5"
 },
 {
  "t0": 152.6,
  "t1": 153.83,
  "text": "一个路名里，",
  "cue": "6-6"
 },
 {
  "t0": 153.88,
  "t1": 157.21,
  "text": "塞着两个国家的面子。",
  "cue": "6-6"
 },
 {
  "t0": 165.6,
  "t1": 168.95,
  "text": "后来这条路又改了三回名：",
  "cue": "7-1"
 },
 {
  "t0": 169.0,
  "t1": 171.35,
  "text": "一九四三年叫大上海路，",
  "cue": "7-2"
 },
 {
  "t0": 171.4,
  "t1": 174.95,
  "text": "一九四五年叫中正东路。",
  "cue": "7-2"
 },
 {
  "t0": 175.0,
  "t1": 178.25,
  "text": "一九五零年，正式改名——",
  "cue": "7-3"
 },
 {
  "t0": 178.3,
  "t1": 181.51,
  "text": "延安东路，叫到今天。",
  "cue": "7-4"
 },
 {
  "t0": 190.6,
  "t1": 192.55,
  "text": "还有个细节：",
  "cue": "8-1"
 },
 {
  "t0": 192.6,
  "t1": 194.49,
  "text": "河道本来就是弯的，",
  "cue": "8-2"
 },
 {
  "t0": 194.54,
  "t1": 198.65,
  "text": "马路跟着河走，也修成了弯的。",
  "cue": "8-2"
 },
 {
  "t0": 198.7,
  "t1": 200.77,
  "text": "侬下回从外滩往西开，",
  "cue": "8-3"
 },
 {
  "t0": 200.82,
  "t1": 205.63,
  "text": "延安东路到西藏路那一带微微一拐——",
  "cue": "8-3"
 },
 {
  "t0": 206.2,
  "t1": 208.11,
  "text": "那不是设计师手抖，",
  "cue": "8-4"
 },
 {
  "t0": 208.16,
  "t1": 210.06,
  "text": "那是洋泾浜的河床，",
  "cue": "8-4"
 },
 {
  "t0": 210.11,
  "t1": 212.95,
  "text": "还躺在马路底下。",
  "cue": "8-4"
 },
 {
  "t0": 213.0,
  "t1": 215.95,
  "text": "河没了，路还在走它当年的道。",
  "cue": "8-5"
 }
]