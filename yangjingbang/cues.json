[
 {
  "id": "1-1",
  "para": 1,
  "shot": 1,
  "text": "侬每天开车走的延安东路，晓得伐——",
  "t": 0.5,
  "est": 3.41
 },
 {
  "id": "1-2",
  "para": 1,
  "shot": 1,
  "text": "一百多年前，它不是路，是河。",
  "t": 4.8,
  "est": 2.86
 },
 {
  "id": "2-1",
  "para": 2,
  "shot": 2,
  "text": "这条河叫洋泾浜，不到两公里长，二十米都不到宽。",
  "t": 9.0,
  "est": 4.95
 },
 {
  "id": "2-2",
  "para": 2,
  "shot": 2,
  "text": "一八四五年，英国人在河的北边划了租界；",
  "t": 15.3,
  "est": 4.1
 },
 {
  "id": "2-3",
  "para": 2,
  "shot": 2,
  "text": "一八四九年，法国人在南边也划了一块。",
  "t": 20.4,
  "est": 3.87
 },
 {
  "id": "2-4",
  "para": 2,
  "shot": 2,
  "text": "一条小河浜，就这么成了两个租界的分界线。",
  "t": 25.2,
  "est": 4.34
 },
 {
  "id": "2-5",
  "para": 2,
  "shot": 2,
  "text": "北岸归英租界管，路叫松江路；",
  "t": 30.6,
  "est": 2.94
 },
 {
  "id": "2-6",
  "para": 2,
  "shot": 2,
  "text": "南岸归法租界，路叫孔子路。",
  "t": 34.4,
  "est": 2.71
 },
 {
  "id": "2-7",
  "para": 2,
  "shot": 2,
  "text": "人要过河，就走桥——",
  "t": 38.2,
  "est": 1.78
 },
 {
  "id": "2-8",
  "para": 2,
  "shot": 2,
  "text": "浜上前后架过九座桥。",
  "t": 41.0,
  "est": 2.09
 },
 {
  "id": "3-1",
  "para": 3,
  "shot": 3,
  "text": "桥拆了，名字留下来了。",
  "t": 46.0,
  "est": 2.24
 },
 {
  "id": "3-2",
  "para": 3,
  "shot": 3,
  "text": "侬现在路过的东新桥、八仙桥，找不到桥了对伐？",
  "t": 49.4,
  "est": 4.67
 },
 {
  "id": "3-3",
  "para": 3,
  "shot": 3,
  "text": "桥就在地名里。",
  "t": 56.0,
  "est": 1.4
 },
 {
  "id": "4-1",
  "para": 4,
  "shot": 4,
  "text": "河两边全是码头洋行，中国人外国人做生意，话讲不通。",
  "t": 65.8,
  "est": 5.42
 },
 {
  "id": "4-2",
  "para": 4,
  "shot": 4,
  "text": "急中生智，上海话夹英语，凑出一套\"洋泾浜英语\"。",
  "t": 72.4,
  "est": 4.72
 },
 {
  "id": "4-3",
  "para": 4,
  "shot": 4,
  "text": "老上海有句顺口溜：",
  "t": 78.8,
  "est": 1.86
 },
 {
  "id": "4-4",
  "para": 4,
  "shot": 4,
  "text": "来是\"康姆\"，去是\"谷\"——",
  "t": 81.3,
  "est": 1.78
 },
 {
  "id": "4-5",
  "para": 4,
  "shot": 4,
  "text": "康姆是来，谷是去，单词套上上海话的壳，能听懂就行。",
  "t": 85.4,
  "est": 5.33
 },
 {
  "id": "4-6",
  "para": 4,
  "shot": 4,
  "text": "现在侬讲一个人英语讲得不地道，叫他\"洋泾浜\"，就是从这条河来的。",
  "t": 92.0,
  "est": 6.58
 },
 {
  "id": "5-1",
  "para": 5,
  "shot": 5,
  "text": "到了一九一四年，河淤塞发臭，桥又堵路，英法两租界一商量：",
  "t": 105.8,
  "est": 6.03
 },
 {
  "id": "5-2",
  "para": 5,
  "shot": 5,
  "text": "填了。",
  "t": 113.4,
  "est": 0.47
 },
 {
  "id": "5-3",
  "para": 5,
  "shot": 5,
  "text": "两年工夫，河道填平，连两岸小路并成一条大马路，是当时上海最宽的路。",
  "t": 115.4,
  "est": 7.19
 },
 {
  "id": "6-1",
  "para": 6,
  "shot": 6,
  "text": "路修好了，名字吵翻了。",
  "t": 135.8,
  "est": 2.24
 },
 {
  "id": "6-2",
  "para": 6,
  "shot": 6,
  "text": "英国人要起英国名，法国人不干。",
  "t": 139.0,
  "est": 3.17
 },
 {
  "id": "6-3",
  "para": 6,
  "shot": 6,
  "text": "最后妥协：",
  "t": 143.2,
  "est": 0.93
 },
 {
  "id": "6-4",
  "para": 6,
  "shot": 6,
  "text": "用英国国王爱德华七世的名，按法文的读法——",
  "t": 144.9,
  "est": 4.34
 },
 {
  "id": "6-5",
  "para": 6,
  "shot": 6,
  "text": "爱多亚路。",
  "t": 150.4,
  "est": 0.93
 },
 {
  "id": "6-6",
  "para": 6,
  "shot": 6,
  "text": "一个路名里，塞着两个国家的面子。",
  "t": 152.6,
  "est": 3.41
 },
 {
  "id": "7-1",
  "para": 7,
  "shot": 7,
  "text": "后来这条路又改了三回名：",
  "t": 165.6,
  "est": 2.56
 },
 {
  "id": "7-2",
  "para": 7,
  "shot": 7,
  "text": "一九四三年叫大上海路，一九四五年叫中正东路。",
  "t": 169.0,
  "est": 4.8
 },
 {
  "id": "7-3",
  "para": 7,
  "shot": 7,
  "text": "一九五零年，正式改名——",
  "t": 175.0,
  "est": 2.24
 },
 {
  "id": "7-4",
  "para": 7,
  "shot": 7,
  "text": "延安东路，叫到今天。",
  "t": 178.3,
  "est": 2.01
 },
 {
  "id": "8-1",
  "para": 8,
  "shot": 8,
  "text": "还有个细节：",
  "t": 190.6,
  "est": 1.16
 },
 {
  "id": "8-2",
  "para": 8,
  "shot": 8,
  "text": "河道本来就是弯的，马路跟着河走，也修成了弯的。",
  "t": 192.6,
  "est": 4.95
 },
 {
  "id": "8-3",
  "para": 8,
  "shot": 8,
  "text": "侬下回从外滩往西开，延安东路到西藏路那一带微微一拐——",
  "t": 198.7,
  "est": 5.73
 },
 {
  "id": "8-4",
  "para": 8,
  "shot": 8,
  "text": "那不是设计师手抖，那是洋泾浜的河床，还躺在马路底下。",
  "t": 206.2,
  "est": 5.65
 },
 {
  "id": "8-5",
  "para": 8,
  "shot": 8,
  "text": "河没了，路还在走它当年的道。",
  "t": 213.0,
  "est": 2.94
 }
]